rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/gokhan-makina-v1/public/data/backups/main {
      allow read, write: if request.auth != null;
    }

    match /artifacts/gokhan-makina-v1/public/data/pushTokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
